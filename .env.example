PORT=8080
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=compro_tromagnon_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRY_HOURS=72

# Default Admin Seed
ADMIN_EMAIL=admin@tromagnon.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Tromagnon Admin

# CORS
CLIENT_ORIGIN=http://localhost:3000
